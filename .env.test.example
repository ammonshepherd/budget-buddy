# Copy to .env.test (gitignored) for the test database: budget-buddy-test,
# project ref kiqbgjgvptgknmboazaq. Never production. See docs/testing.md.

# Public values, read by the app built with `--mode test`.
VITE_SUPABASE_URL=https://kiqbgjgvptgknmboazaq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_tlDbz0dquKOMQ-d9oC8vOA_8r38SmX-

# SECRET. Only the seed script uses it, server-side. Never add a VITE_ prefix.
# Supabase dashboard → budget-buddy-test → Project Settings → API Keys.
