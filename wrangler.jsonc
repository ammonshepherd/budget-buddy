// Cloudflare hosting: a Worker with no code that serves the built app in
// dist/ at https://enoughmoney.app. `.github/workflows/deploy.yml` runs
// `wrangler deploy` after the checks pass on main. Cloudflare reads the
// headers in dist/_headers (written by vite.config.ts).
{
  "name": "enough-money",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" },
  // Only the real domain: no public *.workers.dev copy and no preview URLs,
  // since every build talks to the production database.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "enoughmoney.app", "custom_domain": true }],
}
